{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run lint && npm run boundary-check",
    "typecheck": "tsc -b",
    "test": "npm run test --workspace=@leash/server",
    "lint": "eslint .",
    "boundary-check": "node boundary-check.mjs",
    "build": "tsc -b shared && npm run build --workspace=@leash/web",
    "start": "npm run start --workspace=@leash/server",
    "start:prod": "npm run start:prod --workspace=@leash/server",
    "demo:seed": "npm run demo:seed --workspace=@leash/server --",
    "paypal:smoke": "npm run paypal:smoke --workspace=@leash/server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents": false
  }
}
